# Copy this file to backend/.env and replace placeholders locally.
# Never commit backend/.env or real credentials.

# Database
MONGODB_URI=
DB_NAME=herbal_hub

# Authentication
SECRET_KEY=generate_a_long_random_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Frontend and delivery area
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
GEOAPIFY_API_KEY=
INITIAL_SERVICE_AREA_NAME=Kilinochchi District
INITIAL_SERVICE_AREA_ALIASES=Kilinochchi District,Kilinochchi
SERVICE_AREA_REJECTION_MESSAGE=Sorry, we currently deliver only within Kilinochchi District.
INITIAL_SERVICE_AREA_LATITUDE=9.3803
INITIAL_SERVICE_AREA_LONGITUDE=80.3770

# Profile image storage: local or s3
PROFILE_IMAGE_STORAGE=local
PROFILE_IMAGE_UPLOAD_DIR=uploads/profile-images
PROFILE_IMAGE_MAX_BYTES=5242880
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your_s3_bucket_name

# Plant identification and bilingual enrichment
PLANTNET_API_KEY=
PLANTNET_API_URL=https://my-api.plantnet.org/v2/identify/all
PLANTNET_TIMEOUT_SECONDS=30
PLANTNET_MIN_CONFIDENCE=0.20
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30

# Payments: mock, payhere, or onepay
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_MERCHANT_NAME=Herbal Hub
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_SANDBOX=true
PAYHERE_NOTIFY_URL=https://your-backend.example/api/webhooks/payhere
PAYHERE_RETURN_URL=http://localhost:3000/orders
PAYHERE_CANCEL_URL=http://localhost:3000/checkout
ONEPAY_APP_ID=your_onepay_app_id
ONEPAY_APP_TOKEN=your_onepay_app_token
ONEPAY_HASH_SALT=your_onepay_hash_salt
ONEPAY_API_BASE_URL=https://api.onepay.lk
ONEPAY_TIMEOUT_SECONDS=15
ONEPAY_SANDBOX=true
ONEPAY_NOTIFY_URL=https://your-backend.example/api/webhooks/onepay
ONEPAY_RETURN_URL=http://localhost:3000/orders
ONEPAY_CANCEL_URL=http://localhost:3000/checkout

# Financial ledger and background jobs
REDIS_URL=redis://localhost:6379/0
DATA_ENCRYPTION_KEY=your_fernet_encryption_key
DEFAULT_COMMISSION_PERCENT=10.00
PAYOUT_MODE=manual

# Email, messaging, and optional legacy integrations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
