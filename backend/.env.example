# Copy this file to backend/.env and replace placeholders locally.
# Never commit backend/.env or real credentials.

# Database
MONGODB_URI=
DB_NAME=herbal_hub
ENVIRONMENT=development

# Authentication
SECRET_KEY=generate_a_long_random_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=5
EMAIL_VERIFICATION_EXPIRE_HOURS=24
ADMIN_EMAIL=herbalhub468@gmail.com
ADMIN_PASSWORD=

# Frontend and delivery area
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GEOAPIFY_API_KEY=
INITIAL_SERVICE_AREA_NAME=Kilinochchi District
INITIAL_SERVICE_AREA_ALIASES=Kilinochchi District,Kilinochchi
SERVICE_AREA_REJECTION_MESSAGE=Sorry, we currently deliver only within Kilinochchi District.
INITIAL_SERVICE_AREA_LATITUDE=9.3803
INITIAL_SERVICE_AREA_LONGITUDE=80.3770

# Profile image storage: local or s3. On AWS, prefer an IAM role and leave
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY empty.
PROFILE_IMAGE_STORAGE=local
PROFILE_IMAGE_UPLOAD_DIR=profile-images
PROFILE_IMAGE_MAX_BYTES=5242880
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your_s3_bucket_name

# Plant identification and bilingual enrichment
PLANTNET_API_KEY=
PLANTNET_API_URL=https://my-api.plantnet.org/v2/identify/all
PLANTNET_TIMEOUT_SECONDS=30
PLANTNET_MIN_CONFIDENCE=0.20
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60

# Stripe is the only checkout payment provider.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:3000/orders/{order_id}?payment=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/orders/{order_id}?payment=cancelled

# Financial ledger and background jobs
REDIS_URL=redis://localhost:6379/0
DATA_ENCRYPTION_KEY=your_fernet_encryption_key
DEFAULT_COMMISSION_PERCENT=10.00
PAYOUT_MODE=manual
# Development/testing only. Never enable automatic verification in production.
AUTO_VERIFY_SELLERS=false

# Email, messaging, and optional legacy integrations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
